PORT=5000
NODE_ENV=development

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

CLIENT_ORIGIN=http://localhost:5173

JWT_SECRET=your-random-secret-at-least-32-characters
JWT_EXPIRES_IN=30d

DATABASE_URL=your-database-url

ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_EMAIL=your@email.com
# ADMIN_PASSWORD=YourPassword123    # optional, enables email login for admin
# ADMIN_NAME=Kiran                  # optional

# One-time first-admin bootstrap. Set ADMIN_BOOTSTRAP_ENABLED=true only while running seed:admin,
# then set it back to false before production deployment.

# DSA AI - Exact 5-slot LLM fallback chain
# 1. Groq Key 1 -> GPT-OSS 120B
# 2. Gemini Key 1 -> Gemini 3.1 Flash-Lite
# 3. Groq Key 2 -> GPT-OSS 120B
# 4. Gemini Key 2 -> Gemini 3.5 Flash-Lite
# 5. Groq Key 3 -> GPT-OSS 120B
#
# Each key is intentionally isolated to one router slot. The router alternates
# providers instead of exhausting all Groq keys before trying Gemini.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY_1=your-first-groq-api-key
GROQ_API_KEY_2=your-second-groq-api-key
GROQ_API_KEY_3=your-third-groq-api-key

GEMINI_API_KEY_1=your-first-gemini-api-key
GEMINI_MODEL_1=gemini-3.1-flash-lite
GEMINI_API_KEY_2=your-second-gemini-api-key
GEMINI_MODEL_2=gemini-3.5-flash-lite

# RAG-based Question Novelty Detection (Duplicate Prevention)
# Uses Gemini's OpenAI-compatible embedding endpoint (gemini-embedding-001)
# Configure the embedding provider via environment variables:
EMBEDDING_PROVIDER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
EMBEDDING_PROVIDER_API_KEY=your-gemini-api-key
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=3072
NOVELTY_ENABLED=true
EMBEDDING_TIMEOUT_MS=30000
EMBEDDING_MAX_RETRIES=2
EMBEDDING_RETRY_DELAY_MS=1000
EMBEDDING_CONTENT_MAX_LENGTH=2000
EMBEDDING_INDEX_BATCH_SIZE=10

# Novelty thresholds (cosine similarity)
# DUPLICATE: >= 0.88 → reject candidate
# BORDERLINE: >= 0.75 → allow but flag for observability
# Below 0.75 → NOVEL (accept)
NOVELTY_DUPLICATE_THRESHOLD=0.88
NOVELTY_BORDERLINE_THRESHOLD=0.75
NOVELTY_TOP_K=10
NOVELTY_MAX_REGENERATION_ATTEMPTS=2

# Transactional Email (Nodemailer / SMTP)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@your-domain.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=Axly <noreply@axly.in>
APP_URL=http://localhost:5173

# Transactional Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
SMTP_FROM=Axly <noreply@axly.in>
APP_URL=http://localhost:5173

# Docker
CODE_RUNNER_TOKEN=
CODE_EXECUTION_SERVICE_URL=
